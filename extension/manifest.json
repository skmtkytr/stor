{
  "manifest_version": 3,
  "name": "stor",
  "version": "0.1.0",
  "description": "Send magnet links and .torrent files to your stor daemon.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
